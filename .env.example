PORT=3000
NODE_ENV=production

# ============================================
# SUPABASE (Database)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================
# CLERK (Authentication)
# ============================================
